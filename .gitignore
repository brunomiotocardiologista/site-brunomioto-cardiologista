# Residuos da migracao do Manus. A pasta publica inteira, nao so o
# version.json: o debug-collector.js ficou meses sendo servido no ar
# em /__manus__/debug-collector.js sem ser carregado por ninguem.
client/public/__manus__/
.manus/
.project-config.json

# ---------------------------------------------------------------
# NUNCA PUBLICAR. O repositório é PÚBLICO e o deploy copia a pasta
# inteira com `git add .`, então só o .gitignore protege.
# ---------------------------------------------------------------

# Scripts avulsos de banco. Historicamente carregavam a string de
# conexão do MySQL em texto puro. Não versionar nunca mais.
scripts/*.mjs
scripts/*.cjs
scripts/*.js

# Documentação interna de infraestrutura (histórico de chamado,
# decisões, painéis). Fica só na máquina do Bruno.
INFRAESTRUTURA*.md
DOMINIO*.md

# Qualquer coisa que pareça credencial
*.pem
*.key
*token*
*secret*
*credential*
